rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.phone is string && data.phone.size() >= 9 && data.phone.size() <= 15
        && data.role in ['consumer', 'driver']
        && data.keys().hasAll(['uid', 'name', 'phone', 'role', 'createdAt'])
        && (!('loyaltyPoints' in data) || data.loyaltyPoints is number)
        && (!('loyaltyTier' in data) || (data.loyaltyTier is string && data.loyaltyTier.size() <= 50))
        && (!('isSubscribed' in data) || data.isSubscribed is bool);
    }

    function isValidDriver(data) {
      return data.uid == request.auth.uid
        && data.truckCapacity is number && data.truckCapacity > 0
        && data.waterSource is string && data.waterSource.size() <= 200
        && data.isAvailable is bool
        && data.location is map
        && data.keys().hasAll(['uid', 'truckCapacity', 'waterSource', 'isAvailable', 'location', 'updatedAt'])
        && (!('waterQualityStatus' in data) || (data.waterQualityStatus is string && data.waterQualityStatus.size() <= 200))
        && (!('rating' in data) || data.rating is number)
        && (!('ratingCount' in data) || data.ratingCount is number);
    }

    function isValidOrder(data) {
      return data.consumerId == request.auth.uid
        && data.status == 'pending'
        && data.createdAt == request.time
        && data.locationDescription is string && data.locationDescription.size() <= 1000
        && data.keys().hasAll(['orderId', 'consumerId', 'status', 'createdAt', 'locationDescription']);
    }

    function isValidMessage(data) {
      return data.senderId == request.auth.uid
        && data.text is string && data.text.size() > 0 && data.text.size() <= 1000
        && data.createdAt == request.time
        && data.keys().hasAll(['senderId', 'text', 'createdAt'])
        && data.keys().size() == 3;
    }

    function isValidRating(data) {
      return data.consumerId == request.auth.uid 
        && data.driverId is string && data.driverId.size() > 0
        && data.orderId is string && data.orderId.size() > 0
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.transcript is string && data.transcript.size() <= 2000
        && data.createdAt == request.time
        && data.keys().hasAll(['ratingId', 'consumerId', 'driverId', 'orderId', 'rating', 'transcript', 'createdAt']);
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isSignedIn() && userId == request.auth.uid 
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'role'])
        && isValidUser(incoming());
    }

    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(driverId) && driverId == request.auth.uid && isValidDriver(incoming());
      allow update: if isSignedIn() && driverId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['truckCapacity', 'waterSource', 'isAvailable', 'location', 'updatedAt'])
        && isValidDriver(incoming());
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.consumerId == request.auth.uid || resource.data.driverId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.consumerId == request.auth.uid || resource.data.driverId == request.auth.uid || (resource.data.status == 'pending' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver'));
      
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming());
      
      allow update: if isSignedIn() && (
        (resource.data.consumerId == request.auth.uid && incoming().status == 'cancelled' && existing().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver' && existing().status == 'pending' && (!('driverId' in existing()) || existing().driverId == null) && incoming().status == 'accepted' && incoming().driverId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'driverId', 'updatedAt'])) ||
        (resource.data.driverId == request.auth.uid && incoming().status == 'delivering' && existing().status == 'accepted' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        (resource.data.driverId == request.auth.uid && incoming().status == 'completed' && existing().status == 'delivering' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        (resource.data.consumerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['hasRated']) && incoming().hasRated == true)
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/orders/$(orderId)).data.consumerId == request.auth.uid || get(/databases/$(database)/documents/orders/$(orderId)).data.driverId == request.auth.uid);
        allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming()) && (get(/databases/$(database)/documents/orders/$(orderId)).data.consumerId == request.auth.uid || get(/databases/$(database)/documents/orders/$(orderId)).data.driverId == request.auth.uid);
      }
    }

    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(ratingId) && isValidRating(incoming());
    }
  }
}
